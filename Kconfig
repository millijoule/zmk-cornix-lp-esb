# Cornix upstream v3.0.0 board definitions select the SoC, but predate
# Zephyr 4.1's ZMK board compatibility marker. Extend the existing board
# symbols so only the explicit ZMK board variants opt in.

config BOARD_CORNIX_LEFT
    select ZMK_BOARD_COMPAT if BOARD_CORNIX_LEFT_NRF52840_ZMK

config BOARD_CORNIX_PH_LEFT
    select ZMK_BOARD_COMPAT if BOARD_CORNIX_PH_LEFT_NRF52840_ZMK

config BOARD_CORNIX_RIGHT
    select ZMK_BOARD_COMPAT if BOARD_CORNIX_RIGHT_NRF52840_ZMK
